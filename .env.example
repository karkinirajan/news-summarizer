# Copy to .env and fill in real values. Never commit the real file.
# Every value below is a demo.

# NewsAPI key: https://newsapi.org/account
NEWS_API_KEY=your-newsapi-key
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Optional --------------------------------------------------------------------------
# The model that writes the summaries (default: the model named in the OpenAI SDK's README)
OPENAI_MODEL=gpt-5.5
# Articles per run, 1 to 100 (default 5). The command line option -n overrides it.
NEWS_PAGE_SIZE=5
# Two letter language code to restrict the search, for example en (default: any)
NEWS_LANGUAGE=
# Seconds to wait for NewsAPI and OpenAI (default 30)
REQUEST_TIMEOUT=30
# Characters of an article sent to the model (default 4000)
MAX_ARTICLE_CHARS=4000
# NewsAPI endpoint (default https://newsapi.org/v2/everything); useful to point at a test server
NEWS_API_URL=
# The OpenAI SDK also reads OPENAI_BASE_URL, to use a compatible server
